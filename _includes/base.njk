<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Inner Flowing - Authentic Qigong, Taught Online") }}</title>
    <meta name="description" content="{{ description | default('Authentic Qigong taught live online. One-to-one Qigong courses, private sessions and a 200-Hour Qigong Teacher Training for students worldwide.') }}">
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=cormorant-garamond:400,500,600&family=josefin-sans:300,400,500&family=inter:400,500,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="site-nav">
      <a href="/" class="nav-brand">Inner Flowing</a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links">
        <li><a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a></li>
        <li><a href="/about/"{% if page.url == "/about/" %} class="active"{% endif %}>About</a></li>
        <li><a href="/online-courses/"{% if "/online-courses/" in page.url %} class="active"{% endif %}>Online Courses</a></li>
        <li><a href="/faq/"{% if page.url == "/faq/" %} class="active"{% endif %}>FAQ</a></li>
        <li><a href="/contact/"{% if page.url == "/contact/" %} class="active"{% endif %}>Contact</a></li>
      </ul>
    </nav>

    {{ content | safe }}

    <footer class="site-footer">
      <div class="copyright" style="max-width:560px;margin:0 auto 0.8em;">I travel frequently to give lectures and to collaborate on retreats and other projects, so my regular teaching is online. In-person classes and one-to-one sessions may occasionally be available at selected locations.</div>
      <div class="copyright">&copy; Sebastian Kumos 2019-{{ build.timestamp | getYear }}</div>
      {# <div class="last-updated">Last updated on {{ build.timestamp | displayDate('en-GB') }}</div> #}
    </footer>

    <a href="#" class="back-to-top" id="backToTop" aria-label="Back to top">&uarr;</a>
    <script src="/js/main.js" defer></script>
</body>
</html>
