<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Inner Flowing - Authentic Lineage Qigong in Da Nang") }}</title>
    <meta name="description" content="{{ description | default('Authentic lineage Qigong in Da Nang and online. Outdoor classes, one-to-one online courses, private sessions and a 200-hour teacher training programme.') }}">
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link href="https://fonts.bunny.net/css?family=cormorant-garamond:400,500,600&family=josefin-sans:300,400,500&family=inter:400,500,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="site-nav">
      <a href="/" class="nav-brand">Inner Flowing</a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links">
        <li><a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a></li>
        <li><a href="/about/"{% if page.url == "/about/" %} class="active"{% endif %}>About</a></li>
        <li><a href="/classes/"{% if page.url == "/classes/" %} class="active"{% endif %}>Schedule</a></li>
        <li><a href="/online-courses/"{% if "/online-courses/" in page.url %} class="active"{% endif %}>Online Courses</a></li>
        <li><a href="/friends/"{% if page.url == "/friends/" %} class="active"{% endif %}>Friends</a></li>
        <li><a href="/contact/"{% if page.url == "/contact/" %} class="active"{% endif %}>Contact</a></li>
      </ul>
    </nav>

    {{ content | safe }}

    <footer class="site-footer">
      <div class="copyright">&copy; Sebastian Kumos | Naam Kai LLC {{ build.timestamp | getYear }}</div>
      {# <div class="last-updated">Last updated on {{ build.timestamp | displayDate('en-GB') }}</div> #}
    </footer>

    <a href="#" class="back-to-top" id="backToTop" aria-label="Back to top">&uarr;</a>
    <script src="/js/main.js" defer></script>
</body>
</html>
